[Unit]
Description=Lookout security observability service
Documentation=file:/opt/lookout/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lookout
Group=lookout
WorkingDirectory=/opt/lookout
Environment=NODE_ENV=production
Environment=LOOKOUT_CONFIG=/etc/lookout/lookout.json
Environment=LOOKOUT_MASTER_KEY_FILE=%d/lookout-master-key
LoadCredential=lookout-master-key:/etc/lookout/master-key
ExecStartPre=/usr/bin/node /opt/lookout/scripts/lookout-preflight-upgrade.js
ExecStart=/usr/bin/node /opt/lookout/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StateDirectory=lookout
StateDirectoryMode=0700
RuntimeDirectory=lookout
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
