# This file contains only non-secret process settings. Keep authentication and
# encryption material in root-owned credential files (mode 0600).
NODE_ENV=production
LOOKOUT_CONFIG=/etc/lookout/lookout.json
LOOKOUT_MASTER_KEY_FILE=/etc/lookout/master-key

# Browser-safe Auth and analytics settings for /signup and /setup.
LOOKOUT_SUPABASE_URL=https://your-project.supabase.co
LOOKOUT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
LOOKOUT_POSTHOG_PROJECT_TOKEN=phc_replace_me
LOOKOUT_POSTHOG_HOST=https://us.i.posthog.com
LOOKOUT_POSTHOG_UI_HOST=https://us.posthog.com

# Hosted vendor operations. Configure only on the Lookout SaaS service.
LOOKOUT_OPERATIONS_API_TOKEN=replace_with_at_least_32_random_characters
LOOKOUT_OPERATIONAL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
LOOKOUT_OPERATIONAL_ALERT_EMAIL=operations@example.com
LOOKOUT_OPERATIONAL_EMAIL_FROM=Lookout Operations <operations@example.com>
