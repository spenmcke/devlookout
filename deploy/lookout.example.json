{
  "schemaVersion": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 4173,
    "allowLoopbackAdmin": false,
    "approvedSourceAddresses": ["127.0.0.1", "::1", "::ffff:127.0.0.1"]
  },
  "storage": {
    "dataDirectory": "/var/lib/lookout",
    "requireEncryption": true,
    "retentionDays": 7,
    "auditRetentionDays": 7,
    "maximumPercent": 2
  },
  "auth": {
    "credentialsFile": "/etc/lookout/credentials.json",
    "legacyTokenEnvironment": null
  },
  "collectors": {
    "keysFile": "/etc/lookout/collectors.json",
    "tailscale": {
      "enabled": false,
      "tailnet": null,
      "credentialReference": null,
      "authMode": "api-token",
      "baseUrl": "https://api.tailscale.com",
      "modes": ["network-flow", "configuration-audit"],
      "pollIntervalSeconds": 15,
      "initialLookbackSeconds": 300,
      "ingestionDelaySeconds": 30
    }
  },
  "secrets": {
    "environment": {},
    "files": {}
  },
  "export": {
    "enabled": false,
    "batchSize": 100,
    "maxPending": 50000,
    "flushIntervalSeconds": 30,
    "categories": [],
    "attributeAllowlist": [],
    "includeActor": false
  },
  "webhook": {
    "enabled": false,
    "type": null,
    "endpoint": null,
    "credentialReference": null,
    "batchSize": 50,
    "maxPending": 10000,
    "flushIntervalSeconds": 15,
    "cooldownSeconds": 300
  }
}
