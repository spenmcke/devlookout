#!/bin/sh
set -eu
umask 077

release_version='@LOOKOUT_RELEASE_VERSION@'
cli_url='@LOOKOUT_ORCHESTRATION_URL@'
cli_sha256='@LOOKOUT_ORCHESTRATION_SHA256@'
target_amd64_url='@LOOKOUT_TARGET_AMD64_URL@'
target_amd64_sha256='@LOOKOUT_TARGET_AMD64_SHA256@'
target_arm64_url='@LOOKOUT_TARGET_ARM64_URL@'
target_arm64_sha256='@LOOKOUT_TARGET_ARM64_SHA256@'

fail() { printf '%s\n' "lookout-cli-bootstrap: $*" >&2; exit 1; }
[ "$#" -eq 0 ] || fail 'arguments are not accepted'

if [ "${LOOKOUT_CLI_BOOTSTRAP_TEST_MODE:-0}" = 1 ]; then
  release_version=${LOOKOUT_CLI_BOOTSTRAP_VERSION:-$release_version}
  cli_url=${LOOKOUT_CLI_BOOTSTRAP_URL:-$cli_url}
  cli_sha256=${LOOKOUT_CLI_BOOTSTRAP_SHA256:-$cli_sha256}
  target_amd64_url=${LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_URL:-$target_amd64_url}
  target_amd64_sha256=${LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_SHA256:-$target_amd64_sha256}
  target_arm64_url=${LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_URL:-$target_arm64_url}
  target_arm64_sha256=${LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_SHA256:-$target_arm64_sha256}
  curl_command=${LOOKOUT_CLI_BOOTSTRAP_CURL:-curl}
  node_command=${LOOKOUT_CLI_BOOTSTRAP_NODE:-node}
else
  curl_command=curl
  node_command=node
fi

for command in "$curl_command" "$node_command" tar mktemp awk mkdir rm; do
  command -v "$command" >/dev/null 2>&1 || fail "$command is required"
done
node_major=$("$node_command" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf '0\n')
case "$node_major" in ''|*[!0-9]*) node_major=0 ;; esac
[ "$node_major" -ge 20 ] || fail "Node.js 20+ is required; found major version $node_major"
if command -v sha256sum >/dev/null 2>&1; then checksum_command=sha256sum
elif command -v shasum >/dev/null 2>&1; then checksum_command=shasum
else fail 'sha256sum or shasum is required'; fi

case "$release_version" in v[0-9]*.[0-9]*.[0-9]*) ;; *) fail 'invalid pinned release version' ;; esac
for digest in "$cli_sha256" "$target_amd64_sha256" "$target_arm64_sha256"; do
  case "$digest" in *[!0-9a-f]*|'') fail 'invalid pinned SHA-256 digest' ;; esac
  [ "${#digest}" -eq 64 ] || fail 'invalid pinned SHA-256 digest'
done
if [ "${LOOKOUT_CLI_BOOTSTRAP_TEST_MODE:-0}" != 1 ]; then
  case "$cli_url" in https://*) ;; *) fail 'CLI artifact URL must use HTTPS' ;; esac
  for target_url in "$target_amd64_url" "$target_arm64_url"; do case "$target_url" in https://*) ;; *) fail 'Linux target artifact URL must use HTTPS' ;; esac; done
fi

temporary=$(mktemp -d "${TMPDIR:-/tmp}/lookout-cli.XXXXXX") || fail 'could not create a temporary directory'
cleanup() { rm -rf -- "$temporary"; }
trap cleanup EXIT HUP INT TERM
archive=$temporary/cli.tar.gz
"$curl_command" --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 --output "$archive" "$cli_url" || fail 'CLI artifact download failed'
if [ "$checksum_command" = sha256sum ]; then actual=$(sha256sum "$archive" | awk '{print $1}')
else actual=$(shasum -a 256 "$archive" | awk '{print $1}'); fi
[ "$actual" = "$cli_sha256" ] || fail 'CLI artifact checksum mismatch'

members=$temporary/archive-members
tar -tzf "$archive" > "$members" || fail 'CLI artifact is unreadable'
root=''
while IFS= read -r member; do
  case "$member" in ''|/*|../*|*/../*|*/..|*'//'*) fail 'CLI artifact contains an unsafe path' ;; esac
  first=${member%%/*}
  [ -n "$root" ] || root=$first
  [ "$first" = "$root" ] || fail 'CLI artifact contains multiple roots'
done < "$members"
[ -n "$root" ] || fail 'CLI artifact is empty'
source_directory=$temporary/source
mkdir "$source_directory"
tar -xzf "$archive" -C "$source_directory" --strip-components=1 --no-same-owner --no-same-permissions || fail 'CLI artifact extraction failed'
for required in package.json bin/lookout.js install/fleet.js install/workstation-cli-install.js install/workstation-link.js src/cli/workstation-prepare.js tools/lookout-support-report.js node_modules/yaml/package.json; do
  [ -f "$source_directory/$required" ] && [ ! -L "$source_directory/$required" ] || fail "CLI artifact is missing $required"
done

LOOKOUT_CLI_SOURCE_DIR=$source_directory
LOOKOUT_CLI_RELEASE_VERSION=$release_version
LOOKOUT_CLI_ARTIFACT_SHA256=$cli_sha256
LOOKOUT_CLI_TARGET_AMD64_URL=$target_amd64_url
LOOKOUT_CLI_TARGET_AMD64_SHA256=$target_amd64_sha256
LOOKOUT_CLI_TARGET_ARM64_URL=$target_arm64_url
LOOKOUT_CLI_TARGET_ARM64_SHA256=$target_arm64_sha256
LOOKOUT_CLI_NODE_PATH=$(command -v "$node_command")
export LOOKOUT_CLI_SOURCE_DIR LOOKOUT_CLI_RELEASE_VERSION LOOKOUT_CLI_ARTIFACT_SHA256 LOOKOUT_CLI_TARGET_AMD64_URL LOOKOUT_CLI_TARGET_AMD64_SHA256 LOOKOUT_CLI_TARGET_ARM64_URL LOOKOUT_CLI_TARGET_ARM64_SHA256 LOOKOUT_CLI_NODE_PATH
"$node_command" "$source_directory/install/workstation-cli-install.js"
