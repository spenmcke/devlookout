$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$ReleaseVersion = '@LOOKOUT_RELEASE_VERSION@'
$OrchestrationUrl = '@LOOKOUT_ORCHESTRATION_URL@'
$OrchestrationSha256 = '@LOOKOUT_ORCHESTRATION_SHA256@'
$TargetUrl = '@LOOKOUT_TARGET_URL@'
$TargetSha256 = '@LOOKOUT_TARGET_SHA256@'
$SetupOrigin = if ($env:LOOKOUT_SETUP_ORIGIN) { $env:LOOKOUT_SETUP_ORIGIN } else { 'https://app.devlookout.com' }

function Fail-Prerequisite([string]$Message) {
  [Console]::Error.WriteLine("lookout-bootstrap: prerequisite error: $Message")
  exit 1
}

if ($args.Count -ne 0) { Fail-Prerequisite 'arguments are not accepted' }
if (-not $env:LOOKOUT_SETUP_TOKEN_FILE) { Fail-Prerequisite 'LOOKOUT_SETUP_TOKEN_FILE is required' }
if (-not (Test-Path -LiteralPath $env:LOOKOUT_SETUP_TOKEN_FILE -PathType Leaf)) { Fail-Prerequisite 'setup token file is not a regular file' }

$NodeName = if ($env:LOOKOUT_BOOTSTRAP_TEST_MODE -eq '1' -and $env:LOOKOUT_BOOTSTRAP_NODE) { $env:LOOKOUT_BOOTSTRAP_NODE } else { 'node' }
$Node = @(Get-Command $NodeName -CommandType Application -ErrorAction SilentlyContinue)[0]
if (-not $Node) { Fail-Prerequisite 'Node.js 20+ is required on the orchestration host' }
$NodeMajor = & $Node.Source -p 'Number(process.versions.node.split(".")[0])' 2>$null
if ($LASTEXITCODE -ne 0 -or $NodeMajor -notmatch '^\d+$' -or [int]$NodeMajor -lt 20) {
  Fail-Prerequisite "Node.js 20+ is required on the orchestration host; found major version $NodeMajor"
}

if ($env:LOOKOUT_BOOTSTRAP_TEST_MODE -eq '1') {
  if ($env:LOOKOUT_BOOTSTRAP_VERSION) { $ReleaseVersion = $env:LOOKOUT_BOOTSTRAP_VERSION }
  if ($env:LOOKOUT_BOOTSTRAP_ORCHESTRATION_URL) { $OrchestrationUrl = $env:LOOKOUT_BOOTSTRAP_ORCHESTRATION_URL }
  if ($env:LOOKOUT_BOOTSTRAP_ORCHESTRATION_SHA256) { $OrchestrationSha256 = $env:LOOKOUT_BOOTSTRAP_ORCHESTRATION_SHA256 }
  if ($env:LOOKOUT_BOOTSTRAP_TARGET_URL) { $TargetUrl = $env:LOOKOUT_BOOTSTRAP_TARGET_URL }
  if ($env:LOOKOUT_BOOTSTRAP_TARGET_SHA256) { $TargetSha256 = $env:LOOKOUT_BOOTSTRAP_TARGET_SHA256 }
}

if ($ReleaseVersion -notmatch '^v\d+\.\d+\.\d+$') { Fail-Prerequisite 'invalid pinned release version' }
foreach ($Digest in @($OrchestrationSha256, $TargetSha256)) {
  if ($Digest -notmatch '^[a-f0-9]{64}$') { Fail-Prerequisite 'invalid pinned SHA-256 digest' }
}
if ($env:LOOKOUT_BOOTSTRAP_TEST_MODE -ne '1') {
  if ($OrchestrationUrl -notmatch '^https://') { Fail-Prerequisite 'orchestration artifact URL must use HTTPS' }
  if ($TargetUrl -notmatch '^https://') { Fail-Prerequisite 'target artifact URL must use HTTPS' }
}

$Temporary = Join-Path ([System.IO.Path]::GetTempPath()) ("lookout-bootstrap-" + [Guid]::NewGuid().ToString('N'))
$Archive = Join-Path $Temporary 'orchestration.zip'
$Extracted = Join-Path $Temporary 'extracted'
$TokenFile = $env:LOOKOUT_SETUP_TOKEN_FILE
try {
  New-Item -ItemType Directory -Path $Temporary | Out-Null
  $CurrentSid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
  & icacls.exe $Temporary /inheritance:r /grant:r "*${CurrentSid}:(OI)(CI)F" | Out-Null
  if ($LASTEXITCODE -ne 0) { Fail-Prerequisite 'could not protect the temporary directory' }
  $Token = (Get-Content -LiteralPath $env:LOOKOUT_SETUP_TOKEN_FILE -Raw).Trim()
  if ($Token -notmatch '^(lst|lrc)_[A-Za-z0-9_-]{43}$') { Fail-Prerequisite 'setup token is invalid' }
  Remove-Variable Token

  function Report-Failure([string]$Code) {
    try {
      $ProtectedToken = (Get-Content -LiteralPath $TokenFile -Raw).Trim()
      $Body = @{ setup_token = $ProtectedToken; code = $Code } | ConvertTo-Json -Compress
      try { Invoke-WebRequest -Uri "$SetupOrigin/v1/setup-sessions/failures" -Method Post -ContentType 'application/json' -Body $Body -UseBasicParsing | Out-Null } catch { }
      $DiagnosticKey = [Guid]::NewGuid().ToString('N')
      $DiagnosticBody = @{
        setup_token = $ProtectedToken
        kind = 'failure'
        code = $Code
        phase = 'bootstrap'
        platform = @{ os = 'windows'; architecture = $env:PROCESSOR_ARCHITECTURE; installer_version = $ReleaseVersion }
        idempotency_key = $DiagnosticKey
      } | ConvertTo-Json -Compress
      foreach ($Attempt in 1..3) {
        try {
          Invoke-WebRequest -Uri "$SetupOrigin/v1/setup-support/events" -Method Post -ContentType 'application/json' -Body $DiagnosticBody -UseBasicParsing | Out-Null
          break
        } catch { if ($Attempt -eq 3) { throw } }
      }
      Remove-Variable ProtectedToken
    } catch { }
  }

  try {
    if ($env:LOOKOUT_BOOTSTRAP_TEST_MODE -eq '1' -and (Test-Path -LiteralPath $OrchestrationUrl -PathType Leaf)) {
      Copy-Item -LiteralPath $OrchestrationUrl -Destination $Archive
    } else {
      Invoke-WebRequest -Uri $OrchestrationUrl -OutFile $Archive -UseBasicParsing
    }
  } catch { Report-Failure 'artifact_download'; throw }
  $Actual = (Get-FileHash -LiteralPath $Archive -Algorithm SHA256).Hash.ToLowerInvariant()
  if ($Actual -ne $OrchestrationSha256) { Report-Failure 'artifact_checksum'; Fail-Prerequisite 'orchestration artifact checksum mismatch' }

  Add-Type -AssemblyName System.IO.Compression.FileSystem
  $Zip = [System.IO.Compression.ZipFile]::OpenRead($Archive)
  try {
    foreach ($Entry in $Zip.Entries) {
      $Name = $Entry.FullName.Replace('\', '/')
      if (-not $Name -or $Name.StartsWith('/') -or $Name -match '(^|/)\.\.(/|$)' -or $Name -match '^[A-Za-z]:') {
        Report-Failure 'artifact_extract'
        Fail-Prerequisite 'orchestration artifact contains an unsafe path'
      }
    }
  } finally { $Zip.Dispose() }
  try { Expand-Archive -LiteralPath $Archive -DestinationPath $Extracted }
  catch { Report-Failure 'artifact_extract'; throw }
  $Roots = @(Get-ChildItem -LiteralPath $Extracted -Directory)
  if ($Roots.Count -ne 1) { Report-Failure 'artifact_extract'; Fail-Prerequisite 'orchestration artifact must contain one root directory' }
  $StagedSource = $Roots[0].FullName
  foreach ($Relative in @('install/onboard.js', 'install/fleet.js', 'package.json')) {
    if (-not (Test-Path -LiteralPath (Join-Path $StagedSource $Relative) -PathType Leaf)) { Report-Failure 'artifact_extract'; Fail-Prerequisite "orchestration artifact does not contain $Relative" }
  }
  $Source = Join-Path $Temporary 'source'
  Move-Item -LiteralPath $StagedSource -Destination $Source

  $env:LOOKOUT_SOURCE_DIR = $Source
  $env:LOOKOUT_RELEASE_URL = $TargetUrl
  $env:LOOKOUT_RELEASE_SHA256 = $TargetSha256
  Remove-Item Env:LOOKOUT_SETUP_CODE -ErrorAction SilentlyContinue
  Remove-Item Env:LOOKOUT_ENROLLMENT_CODE -ErrorAction SilentlyContinue
  Remove-Item Env:LOOKOUT_ACTIVATION_CODE -ErrorAction SilentlyContinue
  Write-Output "Starting Lookout $ReleaseVersion orchestrator..."
  & $Node.Source (Join-Path $Source 'install/onboard.js')
  exit $LASTEXITCODE
} finally {
  if (Test-Path -LiteralPath $Temporary) { Remove-Item -LiteralPath $Temporary -Recurse -Force }
}
