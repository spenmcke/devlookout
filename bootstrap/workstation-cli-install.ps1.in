$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$ReleaseVersion = '@LOOKOUT_RELEASE_VERSION@'
$CliUrl = '@LOOKOUT_ORCHESTRATION_URL@'
$CliSha256 = '@LOOKOUT_ORCHESTRATION_SHA256@'
$TargetAmd64Url = '@LOOKOUT_TARGET_AMD64_URL@'
$TargetAmd64Sha256 = '@LOOKOUT_TARGET_AMD64_SHA256@'
$TargetArm64Url = '@LOOKOUT_TARGET_ARM64_URL@'
$TargetArm64Sha256 = '@LOOKOUT_TARGET_ARM64_SHA256@'

function Fail-CliInstall([string]$Message) {
  [Console]::Error.WriteLine("lookout-cli-bootstrap: $Message")
  exit 1
}

if ($args.Count -ne 0) { Fail-CliInstall 'arguments are not accepted' }
$NodeName = if ($env:LOOKOUT_CLI_BOOTSTRAP_TEST_MODE -eq '1' -and $env:LOOKOUT_CLI_BOOTSTRAP_NODE) { $env:LOOKOUT_CLI_BOOTSTRAP_NODE } else { 'node' }
$Node = @(Get-Command $NodeName -CommandType Application -ErrorAction SilentlyContinue)[0]
if (-not $Node) { Fail-CliInstall 'Node.js 20+ is required' }
$NodeMajor = & $Node.Source -p 'Number(process.versions.node.split(".")[0])' 2>$null
if ($LASTEXITCODE -ne 0 -or $NodeMajor -notmatch '^\d+$' -or [int]$NodeMajor -lt 20) { Fail-CliInstall "Node.js 20+ is required; found major version $NodeMajor" }

if ($env:LOOKOUT_CLI_BOOTSTRAP_TEST_MODE -eq '1') {
  if ($env:LOOKOUT_CLI_BOOTSTRAP_VERSION) { $ReleaseVersion = $env:LOOKOUT_CLI_BOOTSTRAP_VERSION }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_URL) { $CliUrl = $env:LOOKOUT_CLI_BOOTSTRAP_URL }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_SHA256) { $CliSha256 = $env:LOOKOUT_CLI_BOOTSTRAP_SHA256 }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_URL) { $TargetAmd64Url = $env:LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_URL }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_SHA256) { $TargetAmd64Sha256 = $env:LOOKOUT_CLI_BOOTSTRAP_TARGET_AMD64_SHA256 }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_URL) { $TargetArm64Url = $env:LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_URL }
  if ($env:LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_SHA256) { $TargetArm64Sha256 = $env:LOOKOUT_CLI_BOOTSTRAP_TARGET_ARM64_SHA256 }
}
if ($ReleaseVersion -notmatch '^v\d+\.\d+\.\d+$') { Fail-CliInstall 'invalid pinned release version' }
foreach ($Digest in @($CliSha256, $TargetAmd64Sha256, $TargetArm64Sha256)) { if ($Digest -notmatch '^[a-f0-9]{64}$') { Fail-CliInstall 'invalid pinned SHA-256 digest' } }
if ($env:LOOKOUT_CLI_BOOTSTRAP_TEST_MODE -ne '1') {
  if ($CliUrl -notmatch '^https://') { Fail-CliInstall 'CLI artifact URL must use HTTPS' }
  if ($TargetAmd64Url -notmatch '^https://' -or $TargetArm64Url -notmatch '^https://') { Fail-CliInstall 'Linux target artifact URL must use HTTPS' }
}

$Temporary = Join-Path ([System.IO.Path]::GetTempPath()) ("lookout-cli-" + [Guid]::NewGuid().ToString('N'))
$Archive = Join-Path $Temporary 'cli.zip'
$Extracted = Join-Path $Temporary 'extracted'
try {
  New-Item -ItemType Directory -Path $Temporary | Out-Null
  if ($env:LOOKOUT_CLI_BOOTSTRAP_TEST_MODE -eq '1' -and (Test-Path -LiteralPath $CliUrl -PathType Leaf)) { Copy-Item -LiteralPath $CliUrl -Destination $Archive }
  else { Invoke-WebRequest -Uri $CliUrl -OutFile $Archive -UseBasicParsing }
  $Actual = (Get-FileHash -LiteralPath $Archive -Algorithm SHA256).Hash.ToLowerInvariant()
  if ($Actual -ne $CliSha256) { Fail-CliInstall 'CLI artifact checksum mismatch' }
  Add-Type -AssemblyName System.IO.Compression.FileSystem
  $Zip = [System.IO.Compression.ZipFile]::OpenRead($Archive)
  try {
    $Root = $null
    foreach ($Entry in $Zip.Entries) {
      $Name = $Entry.FullName.Replace('\', '/')
      if (-not $Name -or $Name.StartsWith('/') -or $Name -match '(^|/)\.\.(/|$)' -or $Name -match '^[A-Za-z]:') { Fail-CliInstall 'CLI artifact contains an unsafe path' }
      $First = $Name.Split('/')[0]
      if (-not $Root) { $Root = $First }
      if ($First -ne $Root) { Fail-CliInstall 'CLI artifact contains multiple roots' }
    }
  } finally { $Zip.Dispose() }
  Expand-Archive -LiteralPath $Archive -DestinationPath $Extracted
  $Roots = @(Get-ChildItem -LiteralPath $Extracted -Directory)
  if ($Roots.Count -ne 1) { Fail-CliInstall 'CLI artifact must contain one root directory' }
  $Source = $Roots[0].FullName
  foreach ($Relative in @('package.json', 'bin/lookout.js', 'install/fleet.js', 'install/workstation-cli-install.js', 'install/workstation-link.js', 'src/cli/workstation-prepare.js', 'tools/lookout-support-report.js', 'node_modules/yaml/package.json')) {
    if (-not (Test-Path -LiteralPath (Join-Path $Source $Relative) -PathType Leaf)) { Fail-CliInstall "CLI artifact is missing $Relative" }
  }
  $env:LOOKOUT_CLI_SOURCE_DIR = $Source
  $env:LOOKOUT_CLI_RELEASE_VERSION = $ReleaseVersion
  $env:LOOKOUT_CLI_ARTIFACT_SHA256 = $CliSha256
  $env:LOOKOUT_CLI_TARGET_AMD64_URL = $TargetAmd64Url
  $env:LOOKOUT_CLI_TARGET_AMD64_SHA256 = $TargetAmd64Sha256
  $env:LOOKOUT_CLI_TARGET_ARM64_URL = $TargetArm64Url
  $env:LOOKOUT_CLI_TARGET_ARM64_SHA256 = $TargetArm64Sha256
  $env:LOOKOUT_CLI_NODE_PATH = $Node.Source
  & $Node.Source (Join-Path $Source 'install/workstation-cli-install.js')
  exit $LASTEXITCODE
} finally {
  if (Test-Path -LiteralPath $Temporary) { Remove-Item -LiteralPath $Temporary -Recurse -Force }
}
